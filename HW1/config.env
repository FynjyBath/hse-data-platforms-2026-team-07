# Узел с NameNode и Secondary NameNode
NAMENODE=team-07-nn

# Узлы с DataNode
DATANODES="team-07-nn team-07-00 team-07-01"

# Подключение с edge-ноды к узлам кластера (пользователь с sudo без пароля)
SSH_USER=team
SSH_KEY=$HOME/.ssh/team_internal

HADOOP_VERSION=3.4.3
HADOOP_URL=https://archive.apache.org/dist/hadoop/common/hadoop-$HADOOP_VERSION/hadoop-$HADOOP_VERSION.tar.gz
JAVA_PACKAGE=openjdk-11-jdk-headless

HADOOP_USER=hadoop

HADOOP_HOME=/opt/hadoop
DATA_DIR=/data/hdfs

REPLICATION=3
