# основные настройки, чтобы не хардкодить их в скриптах
EDGE_NODE="team-07-en"
NN_NODE="team-07-nn"

HIVE_VERSION="4.0.0-alpha-2"
HIVE_HOME="/opt/hive"
HIVE_ARCHIVE_URL="https://archive.apache.org/dist/hive/hive-4.0.0-alpha-2/apache-hive-4.0.0-alpha-2-bin.tar.gz"
PG_JDBC_URL="https://jdbc.postgresql.org/download/postgresql-42.7.3.jar"

# данные для базы метастора
POSTGRES_DB="metastore_db"
POSTGRES_USER="hive"
POSTGRES_PASSWORD="hive_password"

# порты и пути
METASTORE_HOST="${EDGE_NODE}"
METASTORE_PORT=9083
HIVESERVER2_PORT=10000
HDFS_WAREHOUSE_DIR="/user/hive/warehouse"

HDFS_URI="hdfs://team-07-nn:9000"
